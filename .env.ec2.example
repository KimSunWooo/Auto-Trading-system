# EC2 PAPER deployment example — values only, no secrets in git.
# Copy to .env.ec2 on the host and fill locally / from Secrets Manager.

BROKER=kis
TRADING_MODE=live_test
KIS_MODE=paper
ALLOW_LIVE_TRADING=false

PERSISTENCE_MODE=mirror
DATABASE_URL=
# Or discrete RDS fields:
# AWS_RDS_USERNAME=
# AWS_RDS_PASSWORD=
# AWS_RDS_DATABASE=
# AWS_RDS_DB_NAME=auto_trading
# AWS_RDS_SSL=true
# BOOTSTRAP_USER_EMAIL=local-owner@localhost

KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# Never set on PAPER EC2 hosts:
# KIS_MODE=real
# TRADING_MODE=live
# ALLOW_LIVE_TRADING=true
# KIS_LIVE_CONFIRM=I_UNDERSTAND
# KIS_REAL_APP_KEY=
# KIS_REAL_APP_SECRET=
# KIS_REAL_ACCOUNT_NO=

PAPER_MAX_QTY_PER_ORDER=11
PAPER_MAX_BROKER_SUBMITS_PER_DAY=20
PAPER_MAX_POSITION_QTY_PER_SYMBOL=50

PORT=43147
HOSTNAME=0.0.0.0

# Host bind for persistent data (compose uses MIRA_DATA_DIR)
# MIRA_DATA_DIR=/opt/mirae-autobuy/data
