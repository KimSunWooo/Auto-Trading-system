# mock (기본) | kis
BROKER=mock

# mock | paper | live_test | live
# 기본은 반드시 MOCK. LIVE 주문을 기본값으로 켜지 마세요.
TRADING_MODE=MOCK
ALLOW_LIVE_TRADING=false

# instant (기본) | delayed | reject | timeout | unknown | partial
MOCK_BROKER_MODE=instant

# 한국투자증권 Open API — BROKER=kis 일 때 필수
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌 8자리 + 상품코드 2자리 (예: 12345678-01)
KIS_ACCOUNT_NO=
# demo = 모의투자(VTS) 만 이번 단계에서 사용합니다. real 은 넣지 마세요.
KIS_MODE=demo

# 실전 주문은 TRADING_MODE=live + ALLOW_LIVE_TRADING=true + 아래 값이 모두 필요합니다.
# 이번 VTS 검증에서는 설정하지 마세요.
# KIS_LIVE_CONFIRM=I_UNDERSTAND

# LIVE_TEST 한도. 기본값보다 낮은 값만 적용됩니다. 더 큰 값은 무시됩니다.
# LIVE_TEST_MAX_ORDER_KRW=10000
# LIVE_TEST_MAX_DAILY_ORDER_AMOUNT=30000
# LIVE_TEST_MAX_DAILY_ORDER_COUNT=3
# LIVE_TEST_MAX_POSITION_AMOUNT=30000
# LIVE_TEST_MAX_POSITION_COUNT=2

# 로컬/운영자만. 배포(Vercel 등)에는 넣지 않거나 false 로 두세요.
# true 이면 DIY 폼에 예전 프리셋 버튼이 보입니다. localhost / 127.0.0.1 도 동일합니다.
# NEXT_PUBLIC_ADMIN_MODE=true
