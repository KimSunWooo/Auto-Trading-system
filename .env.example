# KIS PAPER operational defaults. Local mock broker product feature removed.
PAPER_RUNTIME_OWNER=accounts
TRADING_MODE=live_test
KIS_MODE=paper
ALLOW_LIVE_TRADING=false

# paper (또는 demo) = 모의투자(VTS). real = 실전 (LOCKED unless fully unlocked).
# REAL 과 PAPER 자격증명은 서로 fallback 하지 않습니다.

# 모의투자(VTS) — bootstrap/operator harness. Normal USER credentials live in DB.
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# 실전 — KIS_MODE=real 일 때만. 현재 REAL LOCKED.
KIS_REAL_ACCOUNT_NO=
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=

# 실전 주문은 TRADING_MODE=live + ALLOW_LIVE_TRADING=true + 아래 값이 모두 필요합니다.
# KIS_LIVE_CONFIRM=I_UNDERSTAND

# PAPER operational policy (LIVE_TEST + KIS paper/demo only). Never applies to REAL.
PAPER_MAX_QTY_PER_ORDER=5
PAPER_MAX_POSITION_QTY_PER_SYMBOL=50

# Persistence.
# json     = JSON file authority (legacy). No DB writes.
# mirror   = JSON save then best-effort RDS projection (failures never resubmit broker).
# database = RDS is trading-ledger authority. Intent/order persist must succeed before KIS submit.
#            JSON is optional cache only; restart recovery reconstitutes from DB when state.json missing.
PERSISTENCE_MODE=database
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/auto_trading

# Auth / credential encryption (AES-GCM). Required for PAPER credential decrypt.
# BROKER_CREDENTIAL_MASTER_KEY=

# Future AI Agent pull (Auto_Trading_AI_Agent). Auto-order stays OFF until PAPER priorities 1–5 pass.
# AI_AGENT_BASE_URL=http://127.0.0.1:8090
# AI_AGENT_AUTH_TOKEN=

# Operator-only PAPER credential rebind after master-key loss (CLI; never web).
# Default dry-run. Secrets via env only — never argv.
# RECOVERY_BROKER_ACCOUNT_ID=
# RECOVERY_KIS_PAPER_ACCOUNT_NO=
# RECOVERY_KIS_PAPER_APP_KEY=
# RECOVERY_KIS_PAPER_APP_SECRET=
# RECOVERY_APPLY=false
# RECOVERY_CONFIRM=REBINDS_EXISTING_PAPER_CREDENTIAL

# VTS / soak opt-in (default off)
# RUN_KIS_VTS_TESTS=true
# RUN_KIS_VTS_ORDER_TESTS=true
