# mock (기본) | kis
BROKER=mock

# mock | paper | live_test | live
# 기본은 반드시 MOCK. LIVE 주문을 기본값으로 켜지 마세요.
TRADING_MODE=MOCK
ALLOW_LIVE_TRADING=false

# instant (기본) | delayed | reject | timeout | unknown | partial
MOCK_BROKER_MODE=instant

# paper (또는 demo) = 모의투자(VTS). real = 실전. 기본은 paper.
# REAL 과 PAPER 자격증명은 서로 fallback 하지 않습니다.
KIS_MODE=paper

# 모의투자(VTS) — BROKER=kis 이고 KIS_MODE=paper 일 때만 사용
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# 실전 — KIS_MODE=real 일 때만 사용. 이번 VTS 검증에서는 비워 두세요.
KIS_REAL_ACCOUNT_NO=
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=

# 실전 주문은 TRADING_MODE=live + ALLOW_LIVE_TRADING=true + 아래 값이 모두 필요합니다.
# 이번 VTS 검증에서는 설정하지 마세요.
# KIS_LIVE_CONFIRM=I_UNDERSTAND

# LIVE_TEST 한도. 기본값보다 낮은 값만 적용됩니다. 더 큰 값은 무시됩니다.
# LIVE_TEST_MAX_ORDER_KRW=10000
# LIVE_TEST_MAX_DAILY_ORDER_AMOUNT=30000
# LIVE_TEST_MAX_DAILY_ORDER_COUNT=3
# LIVE_TEST_MAX_POSITION_AMOUNT=30000
# LIVE_TEST_MAX_POSITION_COUNT=2

# PAPER operational policy (LIVE_TEST + KIS paper/demo only). Never applies to REAL.
PAPER_MAX_QTY_PER_ORDER=5
PAPER_MAX_POSITION_QTY_PER_SYMBOL=50
# Daily broker-submit COUNT is unlimited for operational PAPER long soak.
# Do not set PAPER_MAX_BROKER_SUBMITS_PER_DAY=0 (0 is invalid). VTS harness keeps its own 5/day cap.
# PAPER_MAX_BROKER_SUBMITS_PER_DAY is deprecated for operational PAPER and ignored.
# Optional: PAPER_POLICY_MODE=test restores VTS 1-share / 1-buy / 5-submit harness caps.
# 로컬/운영자만. 배포(Vercel 등)에는 넣지 않거나 false 로 두세요.
# true 이면 DIY 폼에 예전 프리셋 버튼이 보입니다. localhost / 127.0.0.1 도 동일합니다.
# NEXT_PUBLIC_ADMIN_MODE=true

# VTS 통합 테스트 전용. 일반 npm test 에서는 켜지 마세요. REAL 플래그와 함께면 테스트가 ABORT 합니다.
# RUN_KIS_VTS_TESTS=true
# RUN_KIS_VTS_ORDER_TESTS=true
# RUN_KIS_VTS_FLATTEN_TEST=true
# TRADING_STATE_PATH=data/vts-test/manual/paper-account.json

# 해외주식 VTS. 국내 RUN_KIS_VTS_ORDER_TESTS / VTS_TEST_SYMBOL 과 섞지 마세요.
# 읽기 전용 Overseas VTS-A:
# RUN_KIS_VTS_OVERSEAS_TESTS=true
# 해외 PAPER 주문(VTS-B)은 VTS-A PASS 후에만. 현재 기본은 주석 유지:
# RUN_KIS_VTS_OVERSEAS_ORDER_TESTS=true
# VTS_OVERSEAS_TEST_SYMBOL=AAPL
# VTS_OVERSEAS_TEST_EXCHANGE=NASDAQ

# Persistence. Default json keeps the existing paper-account.json authority.
# mirror = JSON save then best-effort RDS projection. database SOT is not implemented.
PERSISTENCE_MODE=json
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/auto_trading
# AWS_RDS_USERNAME=
# AWS_RDS_PASSWORD=
# AWS_RDS_DATABASE=
# AWS_RDS_DB_NAME=auto_trading
# BOOTSTRAP_USER_EMAIL=local-owner@localhost
