{
  "name": "@mirae/market-research-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated quote ingest + research extensions. Default OFF. No trading-core deps.",
  "type": "module",
  "scripts": {
    "ingest:fixture": "tsx ts/ingest/cli.ts --source fixture",
    "aggregate": "tsx ts/redis/cli.ts",
    "compare": "tsx ts/compare/harness.ts",
    "ai:validate": "tsx ts/ai/validate-fixtures.ts",
    "smoke": "tsx ts/compare/harness.ts && tsx ts/ai/validate-fixtures.ts && tsx ts/ingest/cli.ts --source fixture --once",
    "infra:up": "bash scripts/infra-up.sh",
    "infra:down": "bash scripts/infra-down.sh",
    "pipeline:real": "EXTENSIONS_REAL_INFRA=1 tsx ts/adapters/real-pipeline.cli.ts",
    "test": "tsx --test --test-concurrency=1 ts/ingest/*.test.ts",
    "test:real": "EXTENSIONS_REAL_INFRA=1 tsx --test --test-concurrency=1 ts/adapters/kafka-redis.integration.test.ts",
    "test:core-regression": "cd .. && MIRAEMAESU_TEST=1 npx tsx --test --test-concurrency=1 extensions/ts/compare/core-regression.test.ts",
    "proto:gen": "bash scripts/gen-proto.sh",
    "grpc:up": "bash scripts/grpc-up.sh",
    "grpc:down": "bash scripts/grpc-down.sh",
    "grpc:cli": "tsx ts/grpc/cli.ts",
    "test:grpc": "tsx --test --test-concurrency=1 ts/grpc/grpc.integration.test.ts",
    "test:grpc-overlap": "cd .. && MIRAEMAESU_TEST=1 npx tsx --test --test-concurrency=1 extensions/ts/compare/grpc-overlap-regression.test.ts",
    "test:notify": "EXTENSIONS_REAL_INFRA=1 tsx --test --test-concurrency=1 ts/grpc/notify.integration.test.ts",
    "publisher": "python3 -m ats_research.outbox_publisher"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13",
    "ioredis": "^5.4.2",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
